# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=development

# Redis Connection
REDIS_URL=redis://localhost:6379/0

# Application Rate Limiting Defaults
RATE_LIMIT_DEFAULT_PER_MINUTE=600

# Neon Auth Configuration
NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-example.neonauth.us-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
