# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulsetrack
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/pulsetrack
NEON_BRANCH=development

# Redis Connection
REDIS_URL=redis://localhost:6379/0

# Application Rate Limiting Defaults
RATE_LIMIT_DEFAULT_PER_MINUTE=600

# Neon Auth Configuration (Optional)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
